# =============================================================
# .env.example
# GraphChatEngine – Environment Variable Reference
#
# Copy this file to .env and adjust values before running:
#   cp .env.example .env
#
# NEVER commit the real .env file to version control.
# =============================================================

# --- Neo4j credentials ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme        # Change before production deployment!
NEO4J_URI=bolt://neo4j:7687

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# --- Application settings ---
APP_ENV=development            # development | staging | production
LOG_LEVEL=info                 # debug | info | warning | error
