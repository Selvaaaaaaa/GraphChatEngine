# =============================================================
# .env.example
# GraphChatEngine – Environment Variable Reference
#
# USAGE:
#   cp .env.example .env
#   # Then edit .env with your real values
#
# SECURITY:
#   - NEVER commit .env to version control
#   - .env is listed in .gitignore
#   - This .env.example file IS safe to commit (no real secrets)
# =============================================================

# -------------------------------------------------------------
# NEO4J_USER
# The username for connecting to the Neo4j graph database.
# Default: neo4j (this is the built-in Neo4j admin account)
# Used by: api service, loader service
# -------------------------------------------------------------
NEO4J_USER=neo4j

# -------------------------------------------------------------
# NEO4J_PASSWORD
# The password for the Neo4j admin account.
# IMPORTANT: Change this before any production deployment!
# Must match the value set in the neo4j service's NEO4J_AUTH env var.
# Format: NEO4J_AUTH is set as "username/password" in docker-compose.yml
# Used by: api service, loader service
# -------------------------------------------------------------
NEO4J_PASSWORD=changeme

# -------------------------------------------------------------
# NEO4J_URI
# The Bolt protocol URI for connecting to Neo4j.
# bolt:// is the native binary protocol (faster than HTTP).
# Inside Docker: use the service name "neo4j" as the hostname.
# From host machine: use bolt://localhost:7687
# Used by: api service, loader service (Milestone 03+)
# -------------------------------------------------------------
NEO4J_URI=bolt://neo4j:7687

# -------------------------------------------------------------
# KAFKA_BOOTSTRAP_SERVERS
# Comma-separated list of Kafka broker addresses.
# Inside Docker: use the service name "kafka" and the internal port 29092.
# The internal port (29092) is used for container-to-container traffic.
# The external port (9092) is used for host-machine access.
# From host machine: use localhost:9092
# Used by: api service (producer), loader service (consumer) — Milestone 03+
# -------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# -------------------------------------------------------------
# KAFKA_TOPIC
# The Kafka topic name that CSV rows are published to.
# The topic is auto-created on first produce if KAFKA_AUTO_CREATE_TOPICS_ENABLE=true
# in the Kafka service configuration (it is enabled in docker-compose.yml).
# Used by: api service (Milestone 03 — producer)
#          loader service (Milestone 04 — consumer)
# -------------------------------------------------------------
KAFKA_TOPIC=customer-data

# -------------------------------------------------------------
# GROUP_ID
# Consumer group identifier for the Kafka consumer service.
# Allows Kafka to track message offsets per consumer group.
# Used by: loader service (Milestone 04 — consumer)
# -------------------------------------------------------------
GROUP_ID=graphchat-loader-group

# -------------------------------------------------------------
# AUTO_OFFSET_RESET
# Action to take when there is no initial offset in Kafka or if current offset is invalid.
# Allowed values: earliest | latest | none
# Used by: loader service (Milestone 04 — consumer)
# -------------------------------------------------------------
AUTO_OFFSET_RESET=earliest

# -------------------------------------------------------------
# APP_ENV
# Deployment environment identifier.
# Controls behaviour such as log verbosity, CORS strictness, etc.
# Allowed values: development | staging | production
# Used by: api service, loader service
# -------------------------------------------------------------
APP_ENV=development

# -------------------------------------------------------------
# LOG_LEVEL
# Minimum log level that will be printed to stdout.
# Lower levels are more verbose.
# Allowed values: debug | info | warning | error | critical
# Recommended: info (development), warning (production)
# Used by: api service, loader service
# -------------------------------------------------------------
LOG_LEVEL=info
