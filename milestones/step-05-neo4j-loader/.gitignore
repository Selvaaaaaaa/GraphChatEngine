.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Pytest / coverage ---
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# --- Node (if a Node-based UI tool is added later) ---
node_modules/
